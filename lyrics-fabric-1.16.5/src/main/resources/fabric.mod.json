{
  "schemaVersion": 1,
  "id": "lyrics",
  "version": "${version}",
  "name": "Lyrics",
  "description": "Shows the song you are listening to in Minecraft, with synced lyrics (LRCLIB). Client-side only.",
  "authors": ["you"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["dev.lyricsmod.LyricsMod"]
  },
  "depends": {
    "fabricloader": ">=0.11.0",
    "fabric": "*",
    "minecraft": "1.16.x",
    "java": ">=8"
  }
}
